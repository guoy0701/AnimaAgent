# AnimaAgent Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# LLM API key (required, unless using --mock mode)
ANIMA_API_KEY=

# API base URL (leave empty for OpenAI default)
# Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com
ANIMA_BASE_URL=

# Model names
# Qwen: qwen-plus / text-embedding-v4
# DeepSeek: deepseek-chat / deepseek-chat
# OpenAI: gpt-4o-mini / text-embedding-3-small
ANIMA_CHAT_MODEL=qwen-plus
ANIMA_EMBED_MODEL=text-embedding-v4

# Agent name
ANIMA_AGENT_NAME=Anima
